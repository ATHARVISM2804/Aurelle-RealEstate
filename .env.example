# Copy to .env.local for local work (`vercel env pull .env.local` fills most of these).
# Never commit real values: the repo root is served as static files.

# Neon Postgres (injected by the Vercel Marketplace integration)
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# AI assistant. Format provider:model. Providers: groq, anthropic, google.
GROQ_API_KEY=
CHAT_MODEL=groq:openai/gpt-oss-120b
# Optional: retried once if the primary fails before its first token, and per-language overrides
CHAT_MODEL_FALLBACK=
CHAT_MODEL_AR=
CHAT_MODEL_HI=
# Model for lead summaries (defaults to CHAT_MODEL)
SUMMARY_MODEL=
# Hard daily spend cap across all chats, in USD. Above it the assistant only offers a human.
CHAT_DAILY_BUDGET_USD=5
# Price per 1M tokens used for the cap (input, output). Check the provider's pricing page.
CHAT_PRICE_IN_PER_M=0.15
CHAT_PRICE_OUT_PER_M=0.60

# Secrets: generate each with `node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"`
CHAT_TOKEN_SECRET=
CRON_SECRET=

# Cloudflare Turnstile (the site key goes in js/config.js). Test secret: 1x0000000000000000000000000000000AA
TURNSTILE_SECRET=

# Public origin of the site, e.g. https://aurelle.example — dashboard writes must come from it
APP_ORIGIN=http://localhost:3000

# Email (Resend). LEADS_EMAIL_FROM must be on a verified domain before customers get booking emails.
RESEND_API_KEY=
LEADS_EMAIL_TO=
LEADS_EMAIL_FROM=

# Legacy Google Sheet copy of each enquiry (optional)
SHEET_WEBHOOK_URL=
