{
  "framework": null,
  "buildCommand": "",
  "cleanUrls": true,
  "functions": {
    "api/chat.mjs": { "maxDuration": 60 },
    "api/public.mjs": { "maxDuration": 20 },
    "api/admin.mjs": { "maxDuration": 30 },
    "api/cron.mjs": { "maxDuration": 300 }
  },
  "rewrites": [
    { "source": "/api/p/:path*", "destination": "/api/public?r=:path*" },
    { "source": "/api/a/:path*", "destination": "/api/admin?r=:path*" },
    { "source": "/dashboard/:path*", "destination": "/dashboard" }
  ],
  "redirects": [
    { "source": "/(package\\.json|package-lock\\.json)", "destination": "/", "permanent": false }
  ],
  "crons": [{ "path": "/api/cron", "schedule": "0 4 * * *" }],
  "headers": [
    { "source": "/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }] },
    { "source": "/(js|css)/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=3600, must-revalidate" }] },
    { "source": "/(.*)", "headers": [
      { "key": "X-Content-Type-Options", "value": "nosniff" },
      { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
      { "key": "Permissions-Policy", "value": "camera=(), microphone=(), geolocation=()" }
    ] },
    { "source": "/dashboard(.*)", "headers": [
      { "key": "X-Robots-Tag", "value": "noindex, nofollow" },
      { "key": "Cache-Control", "value": "no-store" },
      { "key": "X-Frame-Options", "value": "DENY" },
      { "key": "Content-Security-Policy", "value": "default-src 'self'; script-src 'self'; style-src 'self' https://fonts.googleapis.com; font-src https://fonts.gstatic.com; img-src 'self' data:; connect-src 'self'; frame-ancestors 'none'; base-uri 'none'; form-action 'self'" }
    ] },
    { "source": "/visit(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }, { "key": "Cache-Control", "value": "no-store" }] },
    { "source": "/api/(.*)", "headers": [{ "key": "X-Robots-Tag", "value": "noindex" }] }
  ]
}
