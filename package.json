{
  "name": "aurelle-residence",
  "private": true,
  "description": "Aurelle Residence site + AI assistant + leads dashboard",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vercel dev",
    "test": "node --test \"tests/*.test.mjs\"",
    "test:db": "node --env-file-if-exists=.env.test --test \"tests/db/*.test.mjs\"",
    "migrate": "node --env-file-if-exists=.env.local scripts/migrate.mjs",
    "seed": "node --env-file-if-exists=.env.local scripts/seed.mjs",
    "publish-facts": "node --env-file-if-exists=.env.local scripts/publish-facts.mjs",
    "create-user": "node --env-file-if-exists=.env.local scripts/create-user.mjs",
    "vendor": "node scripts/vendor.mjs",
    "eval": "node --env-file-if-exists=.env.local scripts/eval-chat.mjs",
    "demo": "node --env-file-if-exists=.env.local scripts/demo-data.mjs"
  },
  "dependencies": {
    "@ai-sdk/groq": "^4.0.74",
    "@neondatabase/serverless": "^1.2.0",
    "@vercel/functions": "^3.10.5",
    "ai": "^7.0.159",
    "libphonenumber-js": "^1.13.15",
    "zod": "^4.6.7"
  },
  "optionalDependencies": {
    "@ai-sdk/anthropic": "^4.0.94",
    "@ai-sdk/google": "^4.0.109"
  },
  "devDependencies": {
    "@preact/signals": "^2.11.4",
    "htm": "^3.1.1",
    "pg": "^8.23.1",
    "preact": "^11.1.1"
  }
}
